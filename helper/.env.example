# Copy to .env and chmod 600. Never commit the real file.
HELPER_TOKEN=replace-with-output-of-openssl-rand-hex-32
ARIA2_RPC=http://127.0.0.1:6800/jsonrpc
# ARIA2_SECRET=
# ARIA2_DIR=              # directory as seen by aria2; empty = aria2's default
DOWNLOAD_DIR=/downloads   # where yt-dlp writes when it downloads itself (inside the helper container)
# BROWSER_TIMEOUT=45
# SHOT_MAX_BYTES=250000
# HOST=0.0.0.0
# PORT=6890
# IP_CHECK_URL=http://127.0.0.1:8000/v1/publicip/ip   # e.g. gluetun control server (needs auth on recent versions)
# IP_CHECK_API_KEY=
# IP_FALLBACK_URL=https://api.ipify.org?format=json
