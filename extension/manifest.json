{
  "manifest_version": 3,
  "name": "aria2 Download Forwarder",
  "version": "1.0.0",
  "description": "Send browser downloads to an aria2 JSON-RPC server, or to an optional helper service.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "cookies",
    "windows"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "aria2 Download Forwarder settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/the-bimbly1/aria2-download-forwarder",
  "author": "Anthony Meier"
}
